<decoder name="kaspersky">
  <prematch>KasperskyLab</prematch>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex>SecurityCenter\|(\.*)\|(\.*)\|(\.*)\|(\.*)\|</regex>
    <order>version,event_typee,trash,codee</order>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex>msg=(\.*) \w+=</regex>
    <order>msg</order>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex>rt=(\.*) \w+=</regex>
    <order>rt</order>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex>cs9=(\.*) \w+=</regex>
    <order>cs9</order>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex>cs9Label=(\.*) \w+=</regex>
    <order>cs9Label</order>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex type="pcre2">dhost=([a-zA-Z-0123456789:]+)</regex>
    <order>dhost</order>
</decoder>
<decoder name="kaspersky-custom">
    <parent>kaspersky</parent>
    <regex type="pcre2">\Н\а\з\в\а\н\и\е \о\б\ъ\е\к\т\а: ([a-zA-Z_\-.0123456789]+)</regex>
    <order>objectname</order>
</decoder>
